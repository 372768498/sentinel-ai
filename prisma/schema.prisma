generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ReportTier {
  BASIC
  DEEP
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionState {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum MarketingChannel {
  X
  REDDIT
  TELEGRAM
}

enum MarketingDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  POSTED
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  // Growth OS Sprint 1 — notification preferences (P2-1 schema)
  notificationMode  String               @default("morning") // morning|active|sleep|vacation|custom
  quietHoursStart   Int?
  quietHoursEnd     Int?
  timezone          String               @default("America/New_York")
  vacationUntil     DateTime?
  // Growth OS Sprint 1 — pricing tier (P3-1 schema, gating via can_user_see)
  proTier           String?              // null|watch|pro|desk
  watchlistLimit    Int                  @default(0)
  analyses          AnalysisHistory[]
  subscription      SubscriptionStatus?
  emailLead         EmailLead?
}

model AnalysisHistory {
  id                String         @id @default(cuid())
  ticker            String
  requestedMode     ReportTier
  deepMode          String?
  status            AnalysisStatus @default(QUEUED)
  workerJobId       String?        @unique
  accessToken        String?        @unique
  finalScore        Int?
  rating            String?
  recommendation    String?
  emailDeliveryId   String?
  errorMessage      String?
  resultJson        Json?
  markdownReport    String?
  pdfUrl            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks        ShareLink[]

  @@index([userId, createdAt])
  @@index([status])
}

model SubscriptionStatus {
  id                  String            @id @default(cuid())
  plan                SubscriptionPlan  @default(FREE)
  state               SubscriptionState @default(INACTIVE)
  whopUserId          String?
  whopMembershipId    String?           @unique
  whopProductId       String?
  whopPlanId          String?
  renewsAt            DateTime?
  endsAt              DateTime?
  lastWebhookEvent    String?
  telegramUserId      String?
  telegramInviteLink  String?
  telegramJoinedAt    DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketingDraft {
  id             String               @id @default(cuid())
  channel        MarketingChannel
  persona        String
  ticker         String?
  score          Int?
  headline       String
  body           String
  sourceUrl      String?
  deepLink       String?
  status         MarketingDraftStatus @default(DRAFT)
  redlineOk      Boolean              @default(false)
  redlineNotes   String?
  scheduledFor   DateTime?
  approvedAt     DateTime?
  approvedBy     String?
  rejectedAt     DateTime?
  rejectionReason String?
  postedAt       DateTime?
  externalPostId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, channel, createdAt])
  @@index([ticker])
}

// Growth OS models

model ProWaitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  // 'watch' | 'pro' — captures which tier card the user clicked.
  // No enum yet because the pricing surface may iterate quickly; keep
  // as a free-form string and validate at the API boundary.
  tier      String
  createdAt DateTime @default(now())
  // utm_source attribution; null when joined directly from sentinel.jilo.ai
  source    String?

  @@index([tier])
  @@index([createdAt])
}

model EmailLead {
  id                  String    @id @default(cuid())
  email               String
  ticker              String?
  sourcePath          String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  ref                 String?
  magicToken          String?   @unique
  magicTokenExpiresAt DateTime?
  verifiedAt          DateTime?
  // Growth OS Sprint 1 — up to 3 top-of-funnel ticker seeds from
  // registration step 2. GIN index added in migration SQL.
  seedTickers         String[]  @default([])
  seedTickersAddedAt  DateTime?
  userId              String?   @unique
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([email, ticker])
  @@index([email])
  @@index([magicToken])
}

model ShareLink {
  id            String           @id @default(cuid())
  shareId       String           @unique @default(cuid())
  analysisId    String
  analysis      AnalysisHistory  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  views         Int              @default(0)
  emailCaptures Int              @default(0)
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([shareId])
  @@index([analysisId])
}

model VisitEvent {
  id          String   @id @default(cuid())
  path        String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  ref         String?
  sessionId   String?
  leadId      String?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([utmCampaign])
  @@index([createdAt])
}

model ContentItem {
  id               String   @id @default(cuid())
  contentId        String   @unique
  platform         String
  ticker           String?
  hook             String?
  body             String
  ctaUrl           String?
  riskLevel        String   @default("Low")
  redlineStatus    String   @default("PENDING")
  redlineNotes     String?
  reviewStatus     String   @default("PENDING")
  reviewerComment  String?
  feishuRecordId   String?
  publishTime      DateTime?
  publishedUrl     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([reviewStatus, platform])
  @@index([ticker])
  @@index([feishuRecordId])
}
