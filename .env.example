# Growth OS · Signal + Content Factory (Week 3)
# Daily review-draft generation runs at MARKETING_DAILY_DRAFT_HOUR_ET (default 9)
# in America/New_York timezone (US stock market local time, NOT host local time).
MARKETING_DAILY_DRAFT_ENABLED=false
MARKETING_DAILY_DRAFT_HOUR_ET=9
MARKETING_ALWAYS_ON_DRAFT_ENABLED=false
MARKETING_ALWAYS_ON_DRAFT_INTERVAL_MINUTES=180
MARKETING_TOP_OPPORTUNITIES_PER_DAY=5
MARKETING_MIN_OPPORTUNITY_SCORE=70
ANTHROPIC_API_KEY=

# Growth OS · Content & Notification optimization wire-up flag
# (Sprint 1 — Telegram only for now)
# When true, free Telegram drafts are rendered from the deterministic
# free_telegram_anomaly template instead of the LLM composer. X and
# YouTube Shorts drafts continue to use the LLM in either case.
# Flag off (default) keeps the LLM path fully active — set true only
# after running scripts/preview_new_templates.py and reviewing 24h
# of Feishu drafts (see railway-worker-deploy.md §5.5).
USE_NEW_TEMPLATES=false

# Growth OS · Publish Queue (Week 4)
# Master kill-switch for ALL platform publishers. Default true — must be
# explicitly set to false for any platform to make real posts.
MARKETING_PUBLISH_DRY_RUN=true
# Review-queue poller (consumes review_status=Approved rows from Bitable)
MARKETING_QUEUE_POLL_ENABLED=false
MARKETING_QUEUE_POLL_INTERVAL_SECONDS=300
# X publisher is live-capable only when BOTH kill switches are open:
# MARKETING_PUBLISH_DRY_RUN=false and X_DRY_RUN=false.
# Telegram channel target: prefer numeric chat id; handle is fallback.
TELEGRAM_CHANNEL_ID_PUBLIC=
TELEGRAM_CHANNEL_HANDLE=@SentinelAI_signals

# Growth OS · KPI Aggregator + Daily Digest (Week 5)
# Reads VisitEvent / EmailLead from Postgres, upserts Feishu Performance,
# pushes Daily Growth Digest card. Runs at HOUR_ET:MINUTE_ET (default 16:30 ET
# post-close) Mon-Fri in America/New_York timezone.
MARKETING_DAILY_DIGEST_ENABLED=false
MARKETING_DAILY_DIGEST_HOUR_ET=16
MARKETING_DAILY_DIGEST_MINUTE_ET=30

# Growth OS · Market Intelligence Layer (Week 6)
# Data source adapters — each adapter is independent; missing keys yield empty
# results without aborting other adapters. Priority order:
#   P0 (high-signal): FMP, SEC_API/EDGAR, DataForSEO SERP, Tavily, YouTube
#   P1 (reserved):    Apify, TikHub, Firecrawl
#
# Finance / market
FMP_API_KEY=
SEC_API_KEY=
